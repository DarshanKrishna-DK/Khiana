# Client build-time configuration.
#
# Vite inlines anything prefixed VITE_ at BUILD time, not at runtime. Changing
# these in the Vercel dashboard therefore has no effect until you redeploy.
#
# Leave them unset for local development: every one falls back to localhost,
# which is why the deployed site says "cannot reach the server at
# http://localhost:8787" if you forget to set them in Vercel.

# Game server, HTTP. Railway domain, no trailing slash.
VITE_API_URL=https://your-service.up.railway.app

# Game server, WebSocket. MUST be wss:// and not ws://, because a page served
# over HTTPS is not allowed to open an insecure socket. The browser blocks it
# as mixed content and the game never connects.
VITE_WS_URL=wss://your-service.up.railway.app

# Where the "Spectate" link points.
VITE_SPECTATOR_URL=https://your-spectator.vercel.app
