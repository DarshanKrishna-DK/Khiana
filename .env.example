# ── Agents ───────────────────────────────────────────────────────────────
# Without a key the deterministic fallback brain runs. The game is fully
# playable that way — use it for local dev and as the demo parachute.
#
# Groq is the default provider (free tier, ~2s latency). Set LLM_PROVIDER
# to 'anthropic' and ANTHROPIC_API_KEY instead to switch vendors.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# LLM_PROVIDER=groq                       # groq | anthropic
# LLM_MODEL=llama-3.3-70b-versatile       # verified against the live model list
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_JSON_MODE=true                      # provider-enforced JSON for decisions
# DELIBERATION_TIMEOUT_MS=8000            # an agent that times out does nothing

# ── Game shape ───────────────────────────────────────────────────────────
# Every dial is optional; defaults are the tuned PRD values. Override to
# reshape a demo (shorter game, smaller maze) without touching code.
# TICK_MS=15000
# TOTAL_TICKS=40
# MAZE_SIZE=24
# PLAYERS=8
# SABOTEURS=2
# TASKS_TO_WIN=5
# VISION_RADIUS=3
# MAX_POWERUPS_PER_GAME=3

# ── Demo parachute ───────────────────────────────────────────────────────
# RECORD=true saves the run to server/recordings/ for `npm run playback`.
# RECORD=false
# PLAYBACK_SPEED=1
# PLAYBACK_LOOP=true

# ── Chain ────────────────────────────────────────────────────────────────
# MOCK_CHAIN=true runs everything with zero network. Set to false only after
# Phase 1 is verified green (npm run phase1).
MOCK_CHAIN=true
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
X402_FACILITATOR=https://x402-facilitator.molandak.org

# Optional. Only set this if you have an x402-gated shop endpoint that really
# answers 402. Left blank, powerups settle directly against PowerupShop.sol.
X402_SHOP_URL=

# ── Wallets ──────────────────────────────────────────────────────────────
# ONE mnemonic derives everything, on the standard BIP-44 path:
#   index 0    → engine  (deployer, escrow attestor, shop owner)
#   index 1..8 → agents  (aligned to player ids p1..p8)
#
# Generate one:            cd server && npm run wallets:new
# Print addresses to fund: cd server && npm run wallets
# Faucet:                  https://faucet.monad.xyz
#
# The engine deploys the contracts, so it needs the most. Agents need their
# game stake (5 MON) plus a little gas.
#
# ⚠️ Testnet only. Never put a mainnet mnemonic in this file.
AGENT_MNEMONIC=

# Fill after deploying (cd contracts && npm run deploy)
ESCROW_ADDRESS=
SHOP_ADDRESS=
COMMIT_ADDRESS=

PORT=8787
