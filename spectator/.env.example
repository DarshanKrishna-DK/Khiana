# Spectator build-time configuration.
#
# Vite inlines VITE_ vars at BUILD time. Changing them in Vercel does nothing
# until you redeploy. Unset, they fall back to localhost, which is why a
# deployed spectator shows an empty board and never connects.

# Game server, WebSocket. MUST be wss:// on an HTTPS page: a secure page cannot
# open an insecure socket, and the browser blocks it as mixed content.
VITE_WS_URL=wss://your-service.up.railway.app

# Game server, HTTP. Used for the end-of-game reveal fetch.
VITE_API_URL=https://your-service.up.railway.app

# Block explorer for transaction links in the agent channel.
VITE_EXPLORER=https://testnet.monadscan.com
